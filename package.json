{
  "name": "sciente-evidence-evals",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt-injection-resistant data blocks and a citation-verified RoB 2 appraisal pipeline with an evaluation harness.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build --force && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "test": "vitest run",
    "eval:deterministic": "pnpm --filter @sciente/appraisal-evals run eval:deterministic",
    "eval:judge": "pnpm --filter @sciente/appraisal-evals run eval:judge",
    "scan:leaks": "node scripts/scan-forbidden.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
